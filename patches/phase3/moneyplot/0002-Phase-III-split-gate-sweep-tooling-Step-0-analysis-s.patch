+          f"tau_ice_net@snow={r['tau_ice_net'][kw]:.1e} tau_des@snow={r['tau_des'][kw]:.1e} tau_fo={r['tau_fo']:.1e}  "
+          f"proxy_gas={P_gas:.1e} proxy_ice={P_ice:.1e}")
