+      PDJ2(product1_idx)  = PDJ2(product1_idx)  + w1 * tmp_value
+      PDJ2(product2_idx)  = PDJ2(product2_idx)  + w2 * tmp_value
+      PDJ2(product3_idx)  = PDJ2(product3_idx)  + w3 * tmp_value
